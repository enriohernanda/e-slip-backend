PORT=3000
NODE_ENV=development

# Mode Mocking: 'true' untuk simulasi tanpa server database/HCM asli
DB_MOCK=true
USE_MOCK_HCM=true

# Konfigurasi jika API HCM eksternal sudah ada nanti:
# HCM_API_BASE_URL=https://api-hcm.company.co.id

# Konfigurasi jika PostgreSQL sudah ada nanti:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=eslip_db
